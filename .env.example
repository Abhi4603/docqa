# Copy to .env (same folder). Read by both server/ and ml-service/.

# --- Postgres (local Docker default; for Neon/Supabase paste their URL and add ?sslmode=require)
DATABASE_URL=postgresql://docqa:docqa@localhost:5432/docqa

# --- Express API
PORT=4000
ML_SERVICE_URL=http://localhost:8000
CLIENT_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=50

# --- Embeddings (always via local Ollama: `ollama pull nomic-embed-text`)
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# --- LLM, option 1: local Ollama (free, offline)  `ollama pull qwen2.5:7b`
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b

# --- LLM, option 2: any free OpenAI-compatible API (Groq, OpenRouter, Gemini...)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-key-here
# LLM_MODEL=llama-3.1-8b-instant

# --- Retrieval tuning
RERANK_ENABLED=false
TOP_K=6
CANDIDATE_K=30
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
